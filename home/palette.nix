# Paleta "Giyu", tirada do wallpaper (home/files/wallpapers/giyu.jpg): fundo marrom
# escuro, azul da lâmina como destaque, carmim da guarda, mostarda e verde do haori.
# Os nomes seguem os papéis do Gruvbox (base anterior) para os módulos não mudarem;
# `accent` é a cor de destaque da interface. Trocar o tema = trocar este arquivo.
{
  # Fundos (sombras marrons)
  bg0h = "#100e0c";
  bg0 = "#1a1410";
  bg1 = "#271c14";
  bg2 = "#3a2a1d";
  bg3 = "#4b3727";
  # Texto (pergaminho quente)
  fg0 = "#f2e8d8";
  fg = "#e6d9c3";
  fg4 = "#ac9a83";
  gray = "#7d6b5a";

  # Destaque: o brilho azul da lâmina
  accent = "#8bb8e0";

  red = "#a3263a"; # guarda da espada
  green = "#6b8a4e"; # haori verde
  yellow = "#c59252"; # haori mostarda
  blue = "#5889b4"; # lâmina
  purple = "#8e3a5e";
  aqua = "#5f8f8a";
  orange = "#ac7039";
  brightRed = "#cf4a5a";
  brightGreen = "#93b06e";
  brightYellow = "#e0b070";
  brightBlue = "#8bb8e0";
  brightPurple = "#b86a8c";
  brightAqua = "#88b5ae";
  brightOrange = "#d39050";

  # Maple Mono NF CN (pacote maple-mono.NF-CN): ligaduras, ícones Nerd Font e kana/kanji
  # numa fonte só.
  font.mono = "Maple Mono NF CN";
}
